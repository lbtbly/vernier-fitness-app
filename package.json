{
  "name": "vernier",
  "version": "0.1.0",
  "private": true,
  "description": "Vernier. Single-owner self-hosted health PWA, served from this Mac mini over Tailscale Serve HTTPS.",
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "icons": "bash scripts/build-icons.sh",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "routes": "node scripts/route-table.mjs",
    "strings": "node scripts/strings.mjs --check",
    "strings:rendered": "node scripts/rendered-strings.mjs",
    "css:check": "node scripts/css-structure.mjs",
    "sw": "node scripts/build-sw.mjs",
    "sw:check": "node scripts/build-sw.mjs --check",
    "compliance": "node scripts/compliance.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@napi-rs/canvas": "1.0.7",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.2",
    "node-cron": "4.6.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0",
    "unpdf": "1.8.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
