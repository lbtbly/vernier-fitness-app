# Vernier. Every variable the stack reads, documented, with no real value.
#
# The live file sits beside this one at the project root, is never committed,
# and is generated by SETUP.html. Copy this file, fill the human values, then
# run the two generators:
#
#   node scripts/gen-env.mjs      fills MASTER_KEY and POSTGRES_PASSWORD
#   node scripts/gen-vapid.mjs    fills the VAPID pair
#
# Both refuse to overwrite a value that already has content, and both are safe
# to run twice.
#
# Nothing below is a credential. The placeholders are shaped like the real
# thing and are deliberately not usable.

# ---------------------------------------------------------------------------
# Identity and origin
# ---------------------------------------------------------------------------

# The public origin the app answers on, scheme and host, no trailing slash.
# The sign-in page renders this value on every request. Change it here, restart
# the stack, and the page follows with no code edit.
APP_URL=https://your-machine.your-tailnet.ts.net

# The product name. It reaches the Home Screen label, the manifest, the browser
# title and the Sunday email header.
APP_NAME=Vernier

# The WebAuthn relying party. Use the tailnet domain, not the full host name:
# a bare ts.net is a Public Suffix List entry and throws, and the tailnet domain
# survives renaming the Mac, which the host name does not.
WEBAUTHN_RP_ID=your-tailnet.ts.net

# The name the passkey prompt shows on the phone.
WEBAUTHN_RP_NAME=Vernier

# Every date and time in the product renders in this zone.
TZ=Europe/Paris

# Demonstration data. 1 loads the seed on boot, 0 refuses to write a single row.
#
# The seed writes six measurements and six source records, one per source shape,
# and stamps every one of them `seed` in a generated column no writer can set.
# So a demonstration reading is tellable from a real one by reading the table,
# not by trusting a badge or an id prefix.
#
# It ships as 1 because that is the state the tests and the string walk expect:
# scripts/rendered-strings.mjs reads its list of surfaces out of this database
# and refuses to run when the six sources are not all represented, which is what
# an empty database looks like. Set it to 0 once your own values are flowing.
# The seed is idempotent either way: fixed ids, so a second boot writes nothing
# new and no timestamp moves.
DEMO_MODE=1

# ---------------------------------------------------------------------------
# Generated. Run node scripts/gen-env.mjs, do not type these by hand.
# ---------------------------------------------------------------------------

# 32 random bytes, base64url. Encrypts third-party credentials at rest and
# nothing else. Losing it means re-connecting every integration. It is never
# rendered, never logged, and never leaves the machine.
MASTER_KEY=

# 24 random bytes, base64url. The alphabet is URL safe because the value lands
# inside the connection string.
POSTGRES_PASSWORD=

# The database role and database name. Compose builds the connection string
# from these three.
POSTGRES_USER=health
POSTGRES_DB=health

# ---------------------------------------------------------------------------
# Web Push. Run node scripts/gen-vapid.mjs, do not type these by hand.
# ---------------------------------------------------------------------------

# The P-256 pair, both halves base64url. Regenerating them invalidates every
# subscription the phone has already made, so the generator refuses to replace
# a pair that already exists.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The contact a push service can reach if it needs to. A mailto: or an https:.
VAPID_SUBJECT="mailto:you@example.org"

# ---------------------------------------------------------------------------
# Backup
# ---------------------------------------------------------------------------

# Where the encrypted daily archive lands. Quote it: an iCloud Drive path has
# spaces in it and an unquoted path breaks any shell that reads this file.
BACKUP_DIR="/Users/you/Library/Mobile Documents/com~apple~CloudDocs/Vernier"

# How many daily archives to keep. The retention pass counts ARCHIVES rather
# than days, which is the same number in normal service and is what makes four
# runs in one afternoon leave the last three rather than all four. What it
# removed is recorded on the run row and shown on the Data and backups screen.
BACKUP_RETENTION_DAYS=30

# Optional. With a value here the archive is encrypted under a key derived from
# it; with it empty, under a key derived from MASTER_KEY. Either way the key is
# scrypt over a salt that is different in every archive, so two archives never
# share a key. Set it if you want an archive openable without the secret the
# running app holds. Losing it loses every archive written under it, and there
# is no recovery: that is what encrypted means.
BACKUP_PASSPHRASE=""

# Where the container writes when the configured destination is usable. It is
# the mount point compose creates for BACKUP_DIR, not a path on this Mac, and
# there is no reason to change it.
BACKUP_MOUNT=/app/backups

# ---------------------------------------------------------------------------
# Withings. https://developer.withings.com, an application of type Public Cloud.
# ---------------------------------------------------------------------------

# demo or live. Demonstration mode runs connect, historical import, incremental
# sync and status against a generated Body Smart dataset with no client id and
# no network at all. Left unset, the mode is read: a blank client id or a blank
# secret means demo, and a complete pair means live.
WITHINGS_MODE=demo

# Leave both blank to run the whole Withings flow against the seeded dataset
# with no network and no account.
WITHINGS_CLIENT_ID=""
WITHINGS_CLIENT_SECRET=""

# Must match a Callback Url registered in the Withings developer dashboard
# exactly, byte for byte, and it must match in the authorize call and in the
# token exchange. This path is the one .forge/PREFLIGHT.md tells you to
# register and the one this build serves; the value below is the shape, with
# your own machine and tailnet in it.
#
# Left unset it is derived from APP_URL, which is the value that is already
# correct on this machine.
WITHINGS_REDIRECT_URI=https://your-machine.your-tailnet.ts.net/api/withings/callback

# ---------------------------------------------------------------------------
# Google Calendar. A Google Cloud project with the Calendar API enabled and the
# consent screen published to In production, unverified. Left in Testing, the
# refresh token dies seven days after consent with no code change.
# ---------------------------------------------------------------------------

# demo or live. Demonstration mode runs the picker, the busy periods, the
# dedicated calendar, the confirm diff, the write and the undo against a
# recorded Google with no client id and no network at all, and marks every event
# it writes as a demonstration. Left unset, the mode is read: a blank client id
# or a blank secret means demo, and a complete pair means live.
GOOGLE_MODE=demo

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# A demonstration control: none, outage or revoked. `outage` makes the recorded
# Google unreachable, so the confirm screen falls back to the availability
# already stored on this machine and names the cause. `revoked` makes it refuse
# the grant, so the token is deleted, the connection disconnects with Google's
# own words and nothing is retried. Both prove a real path without a real Google
# account. Leave it at none.
GOOGLE_DEMO_FAULT=none

# Google refuses a redirect URI on a private domain, so the consent round trip
# lands on loopback and the tokens are stored from there.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ---------------------------------------------------------------------------
# Anthropic. The only metered cost in the build. There is no free tier.
# ---------------------------------------------------------------------------

# Leave blank to run photo estimation, menu generation and the explanations
# against the demonstration path with no key and no call.
ANTHROPIC_API_KEY=""

# Validated once at boot against the Models API, so a retired snapshot fails
# loudly at start rather than silently at 02:00.
ANTHROPIC_MODEL=claude-opus-5

# Month-to-date spend ceiling in US dollars. The call is refused rather than
# the ceiling crossed.
ANTHROPIC_MONTHLY_CAP_USD=10

# The rate table, in US dollars per million tokens, read off the pricing page
# for the model named above and typed in here.
#
# IT IS CONFIGURATION AND NOT A CONSTANT IN THE CODE, for two reasons. Prices
# move: Sonnet 5 introductory pricing ends 2026-08-31, so a figure compiled
# into this build would be wrong before the year is out and wrong silently.
# And a ceiling that cannot price the call it is about to allow is not a
# ceiling: leave these blank and a LIVE call is refused rather than made, with
# the missing value named on the AI screen. Demonstration mode needs neither.
#
# With both filled in, demonstration calls are priced notionally as well, which
# is what lets the monthly ceiling be exercised on an installation with no key.
ANTHROPIC_INPUT_USD_PER_MTOK=""
ANTHROPIC_OUTPUT_USD_PER_MTOK=""

# The output budget for one reply, in tokens. This product's own choice about
# its own prompt, and the figure the ceiling prices as the worst case.
ANTHROPIC_MAX_OUTPUT_TOKENS=1024

# demo or live. Blank reads as demo when there is no key and live when there
# is, so an installation with a key can still run the demonstration on purpose.
ANTHROPIC_MODE=""

# ---------------------------------------------------------------------------
# Mail relay for the Sunday review. Leave blank and the review renders in the
# local preview route instead of being sent.
#
# IMPLICIT TLS ONLY, which is what 465 means. The adapter is about a hundred
# lines of node:tls and speaks EHLO, AUTH LOGIN, MAIL FROM, RCPT TO, DATA: no
# STARTTLS upgrade on 587 and no dependency, because PLAN.md line 30 names every
# package this build may install and no mail library is on it.
#
# A HOST WITHOUT A RECIPIENT IS NOT CONFIGURED, and neither is a recipient
# without a host. Half-set values are how a screen ends up claiming mail works
# over a relay that has nowhere to deliver, so both have to be filled or the
# review says, in words, that nothing was sent.
#
# With no user the sender falls back to the recipient, which is right for the
# common case of a relay sending the owner his own weekly summary.
# ---------------------------------------------------------------------------

MAIL_HOST=""
MAIL_PORT=465
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_TO=""
